# .dockerignore - keep production image small and clean
# Version control
.git
.gitignore

# Local environment
.env
.env.*

# Development / testing
vendor
node_modules
tests
scratch_test.php

# Docker compose files & local backups
compose*.yaml
compose*.yml
docker-compose*.yml
backups/

# IDE / editor
.idea
.vscode
*.swp
*.swo

# Logs and caches
storage/logs/*
bootstrap/cache/*
*.log
