meta {
  name: 05. Delete Project (Soft Delete)
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}
  body: none
  auth: inherit
}

script:pre-request {
  const id = bru.getEnvVar("projectId") || bru.getVar("projectId");
  if (id && req.setUrl) {
    const baseUrl = bru.getEnvVar("baseUrl") || bru.getVar("baseUrl") || "http://localhost";
    req.setUrl(`${baseUrl}/api/v1/projects/${id}`);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Project successfully soft-deleted", function() {
    expect(res.body.success).to.be.true;
  });
}
