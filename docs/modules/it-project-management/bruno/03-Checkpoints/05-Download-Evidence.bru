meta {
  name: 05. Download Evidence Stream
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/checkpoints/attachments/{{attachmentId}}/download
  body: none
  auth: inherit
}

tests {
  test("Status code is 200 (or 404 if evidence upload was skipped)", function() {
    expect([200, 404]).to.include(res.getStatus());
  });

  if (res.getStatus() === 200) {
    test("Returns binary stream or octet header", function() {
      expect(res.getHeader('content-type')).to.be.a('string');
    });
  }
}
