meta {
  name: 01. List Checkpoints for Project
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/checkpoints
  body: none
  auth: inherit
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Checkpoints array returned", function() {
    expect(res.body.data).to.be.an('array');
  });

  if (res.body.data && res.body.data.length > 0) {
    test("Checkpoint items have title and status", function() {
      expect(res.body.data[0]).to.have.property('id');
      expect(res.body.data[0]).to.have.property('title');
      expect(res.body.data[0]).to.have.property('status');
    });
  }
}

script:post-response {
  if (res.body && Array.isArray(res.body.data) && res.body.data.length > 0) {
    if (!bru.getEnvVar("checkpointId") && !bru.getVar("checkpointId")) {
      bru.setVar("checkpointId", res.body.data[0].id);
      bru.setEnvVar("checkpointId", res.body.data[0].id);
      console.log("Auto-captured fallback checkpointId from list:", res.body.data[0].id);
    }
  }
}

