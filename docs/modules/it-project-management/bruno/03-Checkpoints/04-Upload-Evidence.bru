meta {
  name: 04. Upload Evidence Attachment (Multipart)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/checkpoints/{{checkpointId}}/attachments
  body: multipart-form
  auth: inherit
}

body:multipart-form {
  file: @file(./dummy-evidence.pdf)
}

tests {
  test("Status code is 201 (or 422 if runner skips multipart file)", function() {
    expect([201, 422]).to.include(res.getStatus());
  });

  if (res.getStatus() === 201) {
    test("Attachment metadata returned", function() {
      expect(res.body.success).to.be.true;
      expect(res.body.data).to.have.property('id');
      expect(res.body.data).to.have.property('file_name');
      expect(res.body.data).to.have.property('download_url');
    });
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setVar("attachmentId", res.body.data.id);
    bru.setEnvVar("attachmentId", res.body.data.id);
    console.log("Captured attachmentId:", res.body.data.id);
  }
}

