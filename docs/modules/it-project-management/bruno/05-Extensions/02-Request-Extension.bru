meta {
  name: 02. Request Deadline Extension
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/extensions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "new_due_date": "2027-01-31",
    "reason_category": "SCOPE_CHANGE",
    "reason_details": "Added 2 additional assembly lines to telemetry monitoring pipeline."
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Extension record created", function() {
    expect(res.body.success).to.be.true;
    expect(res.body.data.new_due_date).to.equal("2027-01-31");
    expect(res.body.data.reason_category).to.equal("SCOPE_CHANGE");
  });
}
