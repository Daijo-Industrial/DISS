meta {
  name: 01. Transition Stage (Sequential or Override)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/transition-stage
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "target_stage": "INITIATION",
    "is_override": false,
    "reason": null
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Project stage updated", function() {
    expect(res.body.success).to.be.true;
    expect(res.body.data.stage).to.equal("INITIATION");
  });
}
