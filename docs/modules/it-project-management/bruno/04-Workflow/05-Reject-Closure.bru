meta {
  name: 05. Reject Project Closure
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/reject-closure
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "comments": "Sign-off document missing supervisor physical signature. Reverting to Monitoring.",
    "return_stage": "MONITORING"
  }
}

tests {
  test("Status code is 200 or 422 depending on current stage", function() {
    expect([200, 422]).to.include(res.getStatus());
  });
}
