meta {
  name: 06. Cancel Project (With Reason Category)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/cancel
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason_category": "REQUESTER_DEPEN_DEP_PRIORITIZED",
    "notes": "Requester department postponed automation to next fiscal year."
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Project status set to CANCELLED", function() {
    expect(res.body.success).to.be.true;
    expect(res.body.data.status).to.equal("CANCELLED");
  });
}
