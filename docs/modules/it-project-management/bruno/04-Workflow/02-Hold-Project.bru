meta {
  name: 02. Place Project On Hold
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/hold
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "Awaiting PLC spare part shipment from vendor overseas."
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Project status set to ON_HOLD", function() {
    expect(res.body.success).to.be.true;
    expect(res.body.data.status).to.equal("ON_HOLD");
  });
}
