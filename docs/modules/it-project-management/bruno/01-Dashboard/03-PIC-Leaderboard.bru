meta {
  name: 03. PIC Leaderboard
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/projects/dashboard/pic-leaderboard
  body: none
  auth: inherit
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Contains leaderboard array", function() {
    expect(res.body.success).to.be.true;
    expect(res.body.data).to.be.an('array');
  });
}
