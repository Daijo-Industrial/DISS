meta {
  name: 04. Upcoming Deadlines
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/projects/dashboard/upcoming-deadlines
  body: none
  auth: inherit
}

params:query {
  ~days: 30
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns array of upcoming deadline projects", function() {
    expect(res.body.success).to.be.true;
    expect(res.body.data).to.be.an('array');
  });

  if (res.body.data && res.body.data.length > 0) {
    test("Project items contain due_date and project_code", function() {
      expect(res.body.data[0]).to.have.property('id');
      expect(res.body.data[0]).to.have.property('project_code');
      expect(res.body.data[0]).to.have.property('due_date');
    });
  }
}
