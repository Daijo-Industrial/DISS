meta {
  name: 01. Login & Get Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "device_name": "bruno-client"
  }
}

script:pre-request {
  const email = bru.getEnvVar("email") || bru.getVar("email");
  const password = bru.getEnvVar("password") || bru.getVar("password");
  if (!email || !password) {
    console.warn("Missing credentials! Please configure 'email' and 'password' in Bruno environment (Local) before sending.");
  }
}

script:post-response {
  if (res.body && res.body.data) {
    if (res.body.data.token) {
      bru.setVar("token", res.body.data.token);
      bru.setEnvVar("token", res.body.data.token);
      console.log("Token stored in session and environment variables.");
    }
    if (res.body.data.user && res.body.data.user.id) {
      bru.setVar("picId", res.body.data.user.id);
      bru.setEnvVar("picId", res.body.data.user.id);
      console.log("Auto-captured picId:", res.body.data.user.id);
    }
    if (res.body.data.user && res.body.data.user.department && res.body.data.user.department.id) {
      bru.setVar("departmentId", res.body.data.user.department.id);
      bru.setEnvVar("departmentId", res.body.data.user.department.id);
      console.log("Auto-captured departmentId:", res.body.data.user.department.id);
    }
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Token and User ID are returned", function() {
    expect(res.body.success).to.be.true;
    expect(res.body.data.token).to.be.a('string');
    expect(res.body.data.user).to.have.property('id');
  });
}
